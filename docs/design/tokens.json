{
  "$description": "导出自设计文件的变量集「主题」(W3C DTCG 格式)。落地实现见 frontend/src/styles/theme.css，变量名映射为 --dcdr-* 前缀。注意：颜色在设计文件里以 0~1 浮点存储，导出取整后个别值与 theme.css 相差 1/255，实现以 theme.css 为唯一来源。",
  "主题": {
    "背景": {
      "$type": "color",
      "$value": "#05080FFF",
      "$extensions": { "modes": { "深色": "#05080FFF", "浅色": "#F5F7FCFF" } }
    },
    "面板": {
      "$type": "color",
      "$value": "#0F141FFF",
      "$extensions": { "modes": { "深色": "#0F141FFF", "浅色": "#FFFFFFFF" } }
    },
    "描边": {
      "$type": "color",
      "$value": "#FFFFFF14",
      "$extensions": { "modes": { "深色": "#FFFFFF14", "浅色": "#080F1F1A" } }
    },
    "主文字": {
      "$type": "color",
      "$value": "#F2F7FFFF",
      "$extensions": { "modes": { "深色": "#F2F7FFFF", "浅色": "#0F141CFF" } }
    },
    "次文字": {
      "$type": "color",
      "$value": "#8A96B5FF",
      "$extensions": { "modes": { "深色": "#8A96B5FF", "浅色": "#5C6378FF" } }
    },
    "弱文字": {
      "$type": "color",
      "$value": "#5E6682FF",
      "$extensions": { "modes": { "深色": "#5E6682FF", "浅色": "#8C94A8FF" } }
    },
    "主强调": {
      "$type": "color",
      "$value": "#2EA8FFFF",
      "$extensions": { "modes": { "深色": "#2EA8FFFF", "浅色": "#0A73D6FF" } }
    },
    "次强调": {
      "$type": "color",
      "$value": "#9482FFFF",
      "$extensions": { "modes": { "深色": "#9482FFFF", "浅色": "#6B54E5FF" } }
    },
    "成功": {
      "$type": "color",
      "$value": "#12DEC4FF",
      "$extensions": { "modes": { "深色": "#12DEC4FF", "浅色": "#0A996BFF" } }
    },
    "警告": {
      "$type": "color",
      "$value": "#FFC247FF",
      "$extensions": { "modes": { "深色": "#FFC247FF", "浅色": "#B87305FF" } }
    },
    "危险": {
      "$type": "color",
      "$value": "#FF8FA8FF",
      "$extensions": { "modes": { "深色": "#FF8FA8FF", "浅色": "#D6334FFF" } }
    },
    "辉光强度": {
      "$type": "number",
      "$value": 1,
      "$extensions": { "modes": { "深色": 1, "浅色": 0.3 } }
    },
    "卡片圆角": {
      "$type": "number",
      "$value": 16,
      "$extensions": { "modes": { "深色": 16, "浅色": 16 } }
    }
  }
}
