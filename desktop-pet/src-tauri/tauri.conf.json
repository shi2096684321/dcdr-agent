{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stepboy",
  "version": "0.1.0",
  "identifier": "com.local.stepboy",
  "build": {
    "devUrl": "http://127.0.0.1:5180",
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "Stepboy",
        "width": 200,
        "height": 300,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "center": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
