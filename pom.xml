<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.dcdr</groupId>
    <artifactId>dcdr-agent</artifactId>
    <version>3.0.0</version>
    <name>一人公司多模态 AI 助手工作台</name>
    <description>一人公司多模态 AI 助手工作台</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <!-- ===== V3.0 LangChain4j 对照版 (feat/v3.0-langchain4j 分支) =====
         BOM 统一管理核心库与集成模块版本, 避免模块间错配。
         注意: LangChain4j 分两条发布线, 两套 BOM 互不包含——
           langchain4j-bom           = 核心库(GA 版号, 如 1.19.0)
           langchain4j-community-bom = 社区厂商集成(带 beta 后缀, 如 1.19.0-beta29)
         两者主版本需保持一致(1.19.0 ↔ 1.19.0-beta29)。 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>1.19.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- V3.2 新增: 社区集成 BOM(dashscope 等厂商集成模块的版本由此统一管理) -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-community-bom</artifactId>
                <version>1.19.0-beta29</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot WebFlux (响应式, 支持 SSE 流式输出) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Spring Boot Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 数据库: H2 + Spring Data JPA (会话/消息/项目持久化) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- PostgreSQL: V2.0/V2.1 生产级 RAG 向量检索, 通过 pg profile 启用。
             向量类型用项目内置的 VectorType (Hibernate UserType) 实现, 零第三方 jar 依赖。 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- V2.2 用户认证与权限管理: Spring Security + JWT (文档 §8 技术选型)
             WebFlux 环境下自动启用 Reactive 版本 (SecurityWebFilterChain) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- V2.2 JWT: jjwt 0.12.x (api + impl + jackson 序列化) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- V3.0 LangChain4j 对照版: 纯库引入(不用 spring-boot-starter 自动配置),
             显式学习框架核心抽象 ChatModel/EmbeddingModel/EmbeddingStore/AiServices。
             DashScope 走 OpenAI 兼容端点, 由 langchain4j-open-ai 直接对接,
             版本由上方 langchain4j-bom 统一管理。 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
        </dependency>

        <!-- V3.0 主模块: AiServices 工具循环 / ChatMemory 窗口策略 / @Tool 注解 schema 生成 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>

        <!-- V3.0 JDK HTTP 客户端实现: langchain4j-open-ai 对其为 optional 依赖,
             显式引入以定制 HttpClientBuilder(强制 HTTP/1.1, 消除 H2 连接池竞态导致的 Connection reset) -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-http-client-jdk</artifactId>
        </dependency>

        <!-- V3.2 RAG 重排(Rerank): 百炼(DashScope) 原生集成, 提供 QwenScoringModel
             (实现 LangChain4j ScoringModel 接口, 底层走阿里官方 dashscope-sdk-java)。
             版本由上方 langchain4j-community-bom 统一管理, 此处不写 version。 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-community-dashscope</artifactId>
        </dependency>

        <!-- V3.2 自建联网搜索: 网页正文提取
             crux = Mozilla Readability 算法的 Java/Kotlin 移植(去导航/广告/页脚, 只留正文),
             用于替代 Tavily 的 extract 能力。
             ⚠️ 必须锁 4.x: 5.x 已重构为 Kotlin 协程(Crux#extractFrom 是 suspend 函数)并移除了
             articles.ArticleExtractor, 从 Java 调用需协程桥接; 4.0 保留同步链式 API。 -->
        <dependency>
            <groupId>com.chimbori.crux</groupId>
            <artifactId>crux</artifactId>
            <version>4.0</version>
        </dependency>

        <!-- V3.2 自建联网搜索: HTML → Markdown 转换(把提取出的正文转成 LLM 友好的 Markdown) -->
        <dependency>
            <groupId>com.vladsch.flexmark</groupId>
            <artifactId>flexmark-html2md-converter</artifactId>
            <version>0.64.8</version>
        </dependency>

        <!-- V3.1 F-43 代码执行沙箱: OpenSandbox Java SDK(自托管沙箱中间件客户端)
             选型理由 / 已排除方案 / 已知坑见 TODO.md「V3.1 F-43 代码执行沙箱」。
             传递依赖: kotlin-stdlib / slf4j-api / okhttp / opentelemetry-api 等, 版本由本坐标锁定。
             注意: 应用只连 opensandbox-server 的 HTTP, 不持有 docker.sock。 -->
        <dependency>
            <groupId>com.alibaba.opensandbox</groupId>
            <artifactId>sandbox</artifactId>
            <version>1.1.0</version>
        </dependency>

        <!-- V2.1 RAG 文档解析: PDF (PDFBox) / Word (POI) / HTML (Jsoup) -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.3</version>
        </dependency>

        <!-- ===== V3.0-rc F-40.2 生产化加固: 系统级可观测性 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Prometheus 指标暴露: /actuator/prometheus -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- F-40.12 分布式追踪: Micrometer Tracing + Brave 桥接, traceId 自动注入日志 MDC -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>
        <!-- F-40.12 追踪导出: Zipkin 上报 (management.tracing.export.zipkin.enabled 控制) -->
        <dependency>
            <groupId>io.zipkin.reporter2</groupId>
            <artifactId>zipkin-reporter-brave</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.3.0</version>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.18.1</version>
        </dependency>

        <!-- 工具库 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 配置元数据 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- SpringDoc OpenAPI (Swagger UI) - 接口文档自动生成 -->
        <!-- 2.6.0 是已缓存、可启动的版本; 之前 swagger 异常是本地残留的旧版 springdoc jar
             污染类路径所致, 并非 2.6.0 本身问题。请确保 IDE 清理缓存后重新导入。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
            <version>2.6.0</version>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- V3.2 集成测试基建: Testcontainers 起真实 PostgreSQL + pgvector。
             用于验证"代码与真实数据库的接缝" —— JPA 实体映射、pgvector 向量检索、
             原生 SQL(余弦距离 / 全文检索), 这些是纯单元测试覆盖不到的部分。
             *IT 命名 → 由 failsafe 在 `mvn verify` 阶段执行, 不影响 `mvn test` 的秒级离线体验。
             版本由 spring-boot-starter-parent 统一管理。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- V3.2 测试分档: 集成测试(*IT)交由 failsafe 在 `mvn verify` 阶段执行,
                 与 surefire 的单元测试(*Test, 即 `mvn test`)隔离。
                 意义: `mvn test` 保持「零外部依赖 + 秒级 + 不花钱」, 可随手跑;
                 需要真实 API Key / 容器 / 外部服务 的测试归入 `mvn verify`。
                 版本由 spring-boot-starter-parent 统一管理, 无需显式指定。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
