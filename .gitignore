.idea

*.iml
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# Maven build output
target/

# ===== Frontend (Node / Vite) =====
# 依赖目录
frontend/node_modules/
# 构建产物
frontend/dist/
# Vite 缓存
frontend/.vite/
frontend/node_modules/.vite/
# 本地环境变量
frontend/.env.local
frontend/.env.*.local
# 后端/部署本地环境变量 (docker compose 读取; 含沙箱 API Key 等, 不入库)
.env

# ===== Runtime artifacts (不应入库) =====
# 应用运行时数据整体不入库: 知识库文档/上传文件/生成图片/H2 数据库等均为用户运行时数据
data/

# PostgreSQL 运行时数据 (Docker 卷或本地挂载, 不入库)
pgdata/
postgres-data/
*.sql.gz

# 运行/测试日志与临时输出
*.txt
build_log.txt
mcp_*.txt

# 运行日志归档目录(单个 *.log 已由上方规则忽略, 此处覆盖 .log.gz 等归档文件)
logs/


