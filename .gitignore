.idea

*.iml
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# Maven build output
target/

# ===== Frontend (Node / Vite) =====
# 依赖目录
frontend/node_modules/
# 构建产物
frontend/dist/
# Vite 缓存
frontend/.vite/
frontend/node_modules/.vite/
# 本地环境变量
frontend/.env.local
frontend/.env.*.local
# 后端/部署本地环境变量 (docker compose 读取; 含沙箱 API Key 等, 不入库)
.env
# 变体与临时备份同样不入库 —— 否则"备份一份 .env"就会变成新的泄露路径
.env.*
!.env.example

# ===== Runtime artifacts (不应入库) =====
# 应用运行时数据整体不入库: 知识库文档/上传文件/生成图片/H2 数据库等均为用户运行时数据
data/

# PostgreSQL 运行时数据 (Docker 卷或本地挂载, 不入库)
pgdata/
postgres-data/
*.sql.gz

# 运行/测试日志与临时输出
*.txt
build_log.txt
mcp_*.txt

# 运行日志归档目录(单个 *.log 已由上方规则忽略, 此处覆盖 .log.gz 等归档文件)
logs/

# ===== 本地工作区数据(不入库) =====
# AI 助手在本地维护的项目数据(记忆/会话), 与代码无关
.workbuddy/
# 设计稿 mockup 的原始生成图, 体积大且已归档进 docs/design/
generated-images/

# ===== 桌宠 desktop-pet (Tauri 子项目) =====
# 与后端工程无构建耦合: Maven 只编译 src/main/java, Dockerfile 只 COPY src。
# 策略: 源码与皮肤包入库, 构建产物和 AI 生成中间物不入库。
# 体积参考: 全量 25 MB, 过滤后约 9 MB。

# 构建输出: exe、启动器、说明
/desktop-pet/dist/
# Rust 编译缓存(正常由 CARGO_TARGET_DIR 指到 C 盘, 此处兜底)
/desktop-pet/src-tauri/target/
# 图标生成的尺寸对照图, 由 npm run icon 重新生成
/desktop-pet/src-tauri/icons/source/icon-preview.png
# AI 生图的姿态原图与生成工程文件(可从 assets/reference 的原图重新生成)
/desktop-pet/pet-actions_assets/
/desktop-pet/pet-actions.miora
# 生成母版(保留 assets/reference 下的原图与对照图)
/desktop-pet/assets/generated/
# 临时脚本与构建快照
/desktop-pet/.tmp_*



